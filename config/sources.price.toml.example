[[sources]]
name = "automax"
url = "https://www.example.com/export/products.xml"
format = "xml"

price_includes_vat = true

[sources.xml]
record_tag = "Produkt"

[sources.fields]
sku = { selector = "SKU" }
price = { selector = "Price", type = "decimal" }
name = { selector = "Name" }


[[sources]]
name = "supplier_csv"
url = "https://supplier.example.com/export.csv"
format = "csv"

[sources.csv]
delimiter = ","
has_header = true

[sources.fields]
sku = { selector = "SKU_CODE" }
price = { selector = "Price", type = "decimal" }
