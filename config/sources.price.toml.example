[[sources]]
name = "automax"
url = "https://www.example.com/export/products.xml"
format = "xml"

[sources.xml]
record_tag = "Produkt"

[sources.fields]
sku = { selector = "SKU" }
price = { selector = "Price", type = "decimal" }
name = { selector = "Name" }
discount = { selector = "DiscountFlag" }

# Rules run in order, applied to each price record. Here the discount applies
# before VAT is removed.
[[sources.rules]]
kind = "discount_multiplier"
field = "discount"
when = "0"
factor = 0.8

[[sources.rules]]
kind = "remove_vat"



[[sources]]
name = "supplier_csv"
url = "https://supplier.example.com/export.csv"
format = "csv"

[sources.csv]
delimiter = ","
has_header = true

[sources.fields]
sku = { selector = "SKU_CODE" }
price = { selector = "Price", type = "decimal" }
