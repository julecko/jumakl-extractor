LOGGING_DIR=logs
LOGGING_DAYS_TO_KEEP=10

MAIL_HOST=smtp.yourprovider.com
MAIL_USERNAME=someusername
MAIL_PASSWORD=...
MAIL_FROM=reports@yourdomain.com
# One or more recipients, separated by commas
MAIL_TO=you@yourdomain.com,colleague@yourdomain.com

# Login for the auth_crawl1 custom handler (see sources/custom/auth_crawl1.rs)
AUTH_CRAWL1_USERNAME=someusername
AUTH_CRAWL1_PASSWORD=...

# Set to "true" to also ping a local pulse agent (https://github.com/julecko/pulse)
# via `pulse-agent-cli notify` with just "Run succeeded"/"Run failed" - no
# other data is sent. Leave unset (or anything other than "true") on a
# machine without pulse installed.
PULSE_NOTIFY=false
